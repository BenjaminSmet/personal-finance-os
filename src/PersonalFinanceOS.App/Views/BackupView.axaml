<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalFinanceOS.App.ViewModels"
             xmlns:l="using:PersonalFinanceOS.App.Localization"
             x:Class="PersonalFinanceOS.App.Views.BackupView"
             x:DataType="vm:BackupViewModel">
  <Border Classes="glass">
    <StackPanel Spacing="14">
      <TextBlock Classes="title" Text="{l:T Backup_Title}" />
      <TextBlock Text="{l:T Backup_Explain}" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="headline" Text="{Binding LastBackupText}" />
          <TextBlock Classes="caption debt" Text="{l:T Backup_Due}" IsVisible="{Binding IsBackupDue}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Content="{l:T Backup_Make}" Click="OnMakeBackup" IsEnabled="{Binding !IsBusy}" />
      </Grid>

      <StackPanel Spacing="4">
        <TextBlock Classes="fieldLabel" Text="{l:T Backup_Reminder}" />
        <ComboBox ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" MinWidth="220"
                  AutomationProperties.Name="{l:T Backup_Reminder}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:ReminderOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <Border Classes="success" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Message, StringFormat='✓  {0}'}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="warning" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Warning, StringFormat='⚠  {0}'}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="error" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Error, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Classes="caption" Text="{l:T Backup_DriveNote}" TextWrapping="Wrap" />

      <Border Classes="separator" />
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="headline" Text="{l:T Backup_RestoreTitle}" />
          <TextBlock Classes="caption" Text="{l:T Backup_RestoreExplain}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Margin="12,0,0,0" Content="{l:T Backup_Choose}" Click="OnChooseRestore" IsEnabled="{Binding !IsBusy}" />
      </Grid>

      <!-- Explicit confirmation before anything is replaced -->
      <Border Classes="warning" IsVisible="{Binding IsConfirmingRestore}">
        <StackPanel Spacing="10">
          <TextBlock Classes="headline" Text="{l:T Backup_ConfirmTitle}" />
          <TextBlock Text="{Binding RestoreSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{l:T Backup_ConfirmExplain}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{l:T Backup_ConfirmRestore}" Command="{Binding ConfirmRestoreCommand}" />
            <Button Content="{l:T Accounts_Cancel}" Command="{Binding CancelRestoreCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
