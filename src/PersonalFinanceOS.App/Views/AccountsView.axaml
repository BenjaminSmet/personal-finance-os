<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalFinanceOS.App.ViewModels"
             xmlns:l="using:PersonalFinanceOS.App.Localization"
             x:Class="PersonalFinanceOS.App.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">
  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="largeTitle" Text="{l:T Accounts_Title}" />
        <TextBlock Classes="secondary" Text="{l:T Accounts_Subtitle}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Content="{l:T Accounts_Add}" VerticalAlignment="Center"
              Command="{Binding OpenFormCommand}" IsVisible="{Binding !IsFormOpen}" HotKey="Ctrl+N" />
    </Grid>

    <Border Classes="success" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding StatusMessage, StringFormat='✓  {0}'}" />
    </Border>

    <!-- New account form -->
    <Border Classes="glass strong" IsVisible="{Binding IsFormOpen}" Padding="26,24">
      <StackPanel Spacing="18">
        <TextBlock Classes="title" Text="{l:T Accounts_Add}" />

        <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,16,Auto,16,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_Name}" />
            <TextBox AutomationProperties.Name="{l:T Accounts_Name}" Text="{Binding NewName}" MaxLength="100" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_Type}" />
            <ComboBox AutomationProperties.Name="{l:T Accounts_Type}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:AccountTypeOption">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="0">
            <TextBlock Classes="fieldLabel" Text="{Binding BalanceLabel}" />
            <TextBox AutomationProperties.Name="{Binding BalanceLabel}" Text="{Binding NewBalanceText}" PlaceholderText="0,00" FontSize="16" />
            <Border Classes="warning" Margin="0,8,0,0" IsVisible="{Binding AmountHint, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding AmountHint, StringFormat='⚠  {0}'}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Classes="caption" Margin="4,8,0,0" TextWrapping="Wrap"
                       Text="{l:T Accounts_OutstandingHint}" IsVisible="{Binding IsCreditCard}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_OpeningDate}" />
            <CalendarDatePicker AutomationProperties.Name="{l:T Accounts_OpeningDate}" SelectedDate="{Binding NewOpeningDate}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Grid.Row="4" Grid.Column="0">
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_Share}" />
            <TextBox AutomationProperties.Name="{l:T Accounts_Share}" Text="{Binding NewShareText}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Classes="caption" Margin="4,8,0,0" TextWrapping="Wrap" Text="{l:T Accounts_ShareHint}" />
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_Notes}" />
            <TextBox AutomationProperties.Name="{l:T Accounts_Notes}" Text="{Binding NewNotes}" MaxLength="1000" />
          </StackPanel>
        </Grid>

        <!-- Credit-card settings (spec §10): entered for every card, nothing assumed -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCreditCard}">
          <Border Classes="separator" />
          <TextBlock Classes="headline" Text="{l:T Card_SettingsTitle}" />
          <TextBlock Classes="caption" Text="{l:T Card_SettingsIntro}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,16,Auto">
          <StackPanel>
            <TextBlock Classes="fieldLabel" Text="{l:T Card_Limit_Label}" />
            <TextBox AutomationProperties.Name="{l:T Card_Limit_Label}" Text="{Binding CardLimitText}" PlaceholderText="{l:T Card_LimitPlaceholder}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Card_StartDay}" />
            <TextBox AutomationProperties.Name="{l:T Card_StartDay}" Text="{Binding CardStartDayText}" PlaceholderText="{l:T Card_StartDayPlaceholder}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Classes="caption" Margin="4,8,0,0" Text="{l:T Card_StartDayHint}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Card_SettlementDay}" />
            <TextBox AutomationProperties.Name="{l:T Card_SettlementDay}" Text="{Binding CardSettlementDayText}" PlaceholderText="{l:T Card_SettlementDayPlaceholder}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Classes="caption" Margin="4,8,0,0" Text="{l:T Card_SettlementDayHint}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Card_SettlementAccount}" />
            <ComboBox AutomationProperties.Name="{l:T Card_SettlementAccount}" ItemsSource="{Binding SettlementOptions}" SelectedItem="{Binding CardSettlementAccount}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:AccountOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        </StackPanel>

        <Border Classes="error" IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding FormError, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="{l:T Accounts_Save}" Command="{Binding SaveCommand}" IsDefault="True" />
          <Button Content="{l:T Accounts_Cancel}" Command="{Binding CancelFormCommand}" IsCancel="True" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Change a card's settings -->
    <Border Classes="glass strong" IsVisible="{Binding IsCardEditOpen}" Padding="26,24">
      <StackPanel Spacing="16">
        <TextBlock Classes="title" Text="{Binding CardEditTitle}" />
        <TextBlock Classes="secondary" Text="{l:T Card_EditIntro}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,16,Auto">
          <StackPanel>
            <TextBlock Classes="fieldLabel" Text="{l:T Card_Limit_Label}" />
            <TextBox AutomationProperties.Name="{l:T Card_Limit_Label}" Text="{Binding CardLimitText}" PlaceholderText="{l:T Card_LimitPlaceholder}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Card_StartDay}" />
            <TextBox AutomationProperties.Name="{l:T Card_StartDay}" Text="{Binding CardStartDayText}" PlaceholderText="{l:T Card_StartDayPlaceholder}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Classes="caption" Margin="4,8,0,0" Text="{l:T Card_StartDayHint}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Card_SettlementDay}" />
            <TextBox AutomationProperties.Name="{l:T Card_SettlementDay}" Text="{Binding CardSettlementDayText}" PlaceholderText="{l:T Card_SettlementDayPlaceholder}" Width="120" HorizontalAlignment="Left" />
            <TextBlock Classes="caption" Margin="4,8,0,0" Text="{l:T Card_SettlementDayHint}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Card_SettlementAccount}" />
            <ComboBox AutomationProperties.Name="{l:T Card_SettlementAccount}" ItemsSource="{Binding SettlementOptions}" SelectedItem="{Binding CardSettlementAccount}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:AccountOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        <Border Classes="error" IsVisible="{Binding CardError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding CardError, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="{l:T Accounts_Save}" Command="{Binding SaveCardCommand}" />
          <Button Content="{l:T Accounts_Cancel}" Command="{Binding CancelCardCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Reconcile with a bank statement (spec §5): a difference is shown, never hidden -->
    <Border Classes="glass strong" IsVisible="{Binding IsReconcileOpen}" Padding="26,24">
      <StackPanel Spacing="16">
        <TextBlock Classes="title" Text="{Binding ReconcileTitle}" />
        <TextBlock Classes="secondary" Text="{l:T Reconcile_Intro}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,20,*">
          <StackPanel>
            <TextBlock Classes="fieldLabel" Text="{l:T Reconcile_Date}" />
            <CalendarDatePicker AutomationProperties.Name="{l:T Reconcile_Date}" SelectedDate="{Binding ReconcileDate}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{Binding ReconcileBalanceLabel}" />
            <TextBox AutomationProperties.Name="{Binding ReconcileBalanceLabel}" Text="{Binding ReconcileBalanceText}" PlaceholderText="0,00" FontSize="16" />
          </StackPanel>
        </Grid>

        <Border Classes="success">
          <Border.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!ReconcileHasDifference" />
              <Binding Path="ReconcilePreview" Converter="{x:Static ObjectConverters.IsNotNull}" />
            </MultiBinding>
          </Border.IsVisible>
          <TextBlock Text="{Binding ReconcilePreview, StringFormat='✓  {0}'}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Spacing="12" IsVisible="{Binding ReconcileHasDifference}">
          <Border Classes="warning">
            <TextBlock Text="{Binding ReconcilePreview, StringFormat='⚠  {0}'}" TextWrapping="Wrap" />
          </Border>
          <StackPanel>
            <TextBlock Classes="fieldLabel" Text="{l:T Reconcile_Reason}" />
            <TextBox AutomationProperties.Name="{l:T Reconcile_Reason}" Text="{Binding ReconcileReason}" MaxLength="200" PlaceholderText="{l:T Reconcile_ReasonPlaceholder}" />
            <TextBlock Classes="caption" Margin="4,8,0,0" Text="{l:T Reconcile_AdjustmentHint}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <Border Classes="error" IsVisible="{Binding ReconcileError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding ReconcileError, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="{l:T Reconcile_Save}" Command="{Binding SaveReconciliationCommand}" />
          <Button Content="{l:T Reconcile_SaveWithAdjustment}" Command="{Binding SaveReconciliationWithAdjustmentCommand}"
                  IsVisible="{Binding ReconcileHasDifference}" />
          <Button Content="{l:T Accounts_Cancel}" Command="{Binding CancelReconcileCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Empty state -->
    <Border Classes="glass" IsVisible="{Binding IsEmpty}" Padding="26,24">
      <TextBlock Classes="secondary" Text="{l:T Accounts_Empty}" TextWrapping="Wrap" />
    </Border>

    <!-- Grouped list, iOS style: one glass card, rows separated by hairlines -->
    <Border Classes="glass" Padding="6" IsVisible="{Binding !IsEmpty}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:AccountRowViewModel">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="14,12">
                <Border Width="40" Height="40" CornerRadius="20" Background="{Binding IconBackground}" VerticalAlignment="Center">
                  <Path Data="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" Stroke="White"
                        StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="headline" Text="{Binding Name}" />
                    <Border Classes="badge" IsVisible="{Binding IsArchived}">
                      <TextBlock Classes="caption" Text="{l:T Accounts_Archived}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="secondary" FontSize="13" Text="{Binding TypeName}" />
                  <TextBlock Classes="caption" Text="{Binding ShareText}" IsVisible="{Binding HasPartialShare}" />
                  <TextBlock Classes="caption" Text="{Binding CardText}" IsVisible="{Binding HasCardText}" Classes.debt="{Binding CardMissing}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding ReconciliationText}" IsVisible="{Binding !HasReconciliationDifference}" />
                  <TextBlock Classes="caption debt" Text="{Binding ReconciliationText, StringFormat='⚠ {0}'}"
                             IsVisible="{Binding HasReconciliationDifference}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
                  <TextBlock Classes="amount" Text="{Binding BalanceText}" HorizontalAlignment="Right"
                             Classes.debt="{Binding IsLiability}" />
                  <TextBlock Classes="caption" HorizontalAlignment="Right" Text="{Binding SinceText}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="{l:T Accounts_EditCard}" Padding="14,6" FontSize="13" Command="{Binding EditCardCommand}"
                          IsVisible="{Binding CanEditCard}" />
                  <Button Content="{l:T Accounts_Reconcile}" Padding="14,6" FontSize="13" Command="{Binding ReconcileCommand}"
                          IsVisible="{Binding CanReconcile}" />
                  <Button Content="{l:T Accounts_Archive}" Padding="14,6" FontSize="13" Command="{Binding ArchiveCommand}"
                          IsVisible="{Binding !IsArchived}" />
                </StackPanel>
              </Grid>
              <Border Classes="separator" Margin="68,0,14,0" IsVisible="{Binding !IsLast}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border Classes="glass" Padding="20,12">
      <ToggleSwitch Content="{l:T Accounts_ShowArchived}" IsChecked="{Binding ShowArchived}" />
    </Border>
  </StackPanel>
</UserControl>
