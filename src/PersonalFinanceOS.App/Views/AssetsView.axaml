<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalFinanceOS.App.ViewModels"
             xmlns:l="using:PersonalFinanceOS.App.Localization"
             x:Class="PersonalFinanceOS.App.Views.AssetsView"
             x:DataType="vm:AssetsViewModel">
  <UserControl.Resources>
    <!-- One net worth line: name, where the value comes from, the share, the user's part and what can be done. -->
    <DataTemplate x:Key="NetWorthLine" DataType="vm:NetWorthLineViewModel">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="headline" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <Border Classes="badge" IsVisible="{Binding IsStale}">
                <TextBlock Classes="caption debt" Text="{l:T Assets_StaleBadge}" />
              </Border>
              <Border Classes="badge" IsVisible="{Binding IsUncertain}">
                <TextBlock Classes="caption debt" Text="{l:T Assets_MissingBadge}" />
              </Border>
            </StackPanel>
            <TextBlock Classes="caption" TextWrapping="Wrap">
              <Run Text="{Binding KindText}" />
              <Run Text=" · " />
              <Run Text="{Binding SourceText}" />
            </TextBlock>
            <TextBlock Classes="caption" Text="{Binding ShareText}" IsVisible="{Binding HasPartialShare}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="headline" Classes.debt="{Binding IsLiability}" Text="{Binding ValueText}"
                     VerticalAlignment="Center" Margin="16,0" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Padding="12,5" FontSize="13" Content="{l:T Assets_EnterValue}" Command="{Binding ValueCommand}" IsVisible="{Binding CanValue}" />
            <Button Padding="12,5" FontSize="13" Content="{l:T Assets_ChangeShare}" Command="{Binding ShareCommand}" IsVisible="{Binding CanChangeShare}" />
          </StackPanel>
        </Grid>
        <Border Classes="separator" IsVisible="{Binding !IsLast}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="largeTitle" Text="{l:T Assets_Title}" />
        <TextBlock Classes="secondary" Text="{l:T Assets_Subtitle}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Content="{l:T Assets_Add}" Command="{Binding OpenAddCommand}" VerticalAlignment="Center"
              IsVisible="{Binding !IsAddOpen}" />
    </Grid>

    <Border Classes="success" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding StatusMessage, StringFormat='✓  {0}'}" TextWrapping="Wrap" />
    </Border>

    <!-- Add an asset or liability -->
    <Border Classes="glass" Padding="24,20" IsVisible="{Binding IsAddOpen}">
      <StackPanel Spacing="14">
        <TextBlock Classes="title" Text="{l:T Assets_AddTitle}" />
        <TextBlock Classes="secondary" Text="{l:T Assets_AddNote}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,12,Auto,12,Auto">
          <StackPanel>
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_Name}" />
            <TextBox Text="{Binding NewName}" MaxLength="100" PlaceholderText="{l:T Assets_NamePlaceholder}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_Type}" />
            <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding NewKind}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:AssetKindOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Assets_Value}" />
            <TextBox Text="{Binding NewValueText}" PlaceholderText="0,00" />
            <TextBlock Classes="caption" Margin="4,6,0,0" Text="{l:T Assets_ValueHint}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Assets_ValueDate}" />
            <CalendarDatePicker SelectedDate="{Binding NewValueDate}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Row="4">
            <TextBlock Classes="fieldLabel" Text="{l:T Assets_YourShare}" />
            <TextBox Text="{Binding NewShareText}" PlaceholderText="100" />
          </StackPanel>
          <StackPanel Grid.Row="4" Grid.Column="2">
            <TextBlock Classes="fieldLabel" Text="{l:T Accounts_Notes}" />
            <TextBox Text="{Binding NewNotes}" MaxLength="1000" />
          </StackPanel>
        </Grid>
        <Border Classes="error" IsVisible="{Binding AddError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding AddError, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="{l:T Editor_Save}" Command="{Binding SaveAssetCommand}" />
          <Button Content="{l:T Accounts_Cancel}" Command="{Binding CancelAddCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="glass" Padding="24,20" IsVisible="{Binding !HasAnything}">
      <TextBlock Text="{l:T Assets_Empty}" TextWrapping="Wrap" />
    </Border>

    <StackPanel Spacing="18" IsVisible="{Binding HasAnything}">
      <!-- Net worth: the user's share of everything owned minus everything owed -->
      <Border Classes="glass strong" Padding="28,24">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="overline" Text="{l:T Assets_NetWorth}" />
            <TextBlock Classes="bigAmount" Classes.debt="{Binding TotalIsNegative}" Text="{Binding TotalText}" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Spacing="2">
              <TextBlock Classes="overline" Text="{l:T Assets_Assets}" />
              <TextBlock Classes="amount" Text="{Binding AssetsText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Classes="overline" Text="{l:T Assets_Liabilities}" />
              <TextBlock Classes="amount debt" Text="{Binding LiabilitiesText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2" IsVisible="{Binding HasShared}">
              <TextBlock Classes="overline" Text="{l:T Assets_Household}" />
              <TextBlock Classes="amount" Text="{Binding HouseholdText}" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="caption" Text="{l:T Assets_Explanation}" TextWrapping="Wrap" />
          <Border Classes="warning" IsVisible="{Binding CompletenessNote, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding CompletenessNote, StringFormat='ℹ  {0}'}" TextWrapping="Wrap" />
          </Border>
          <Border Classes="warning" IsVisible="{Binding StaleNote, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding StaleNote, StringFormat='⚠  {0}'}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Panel for one line: a new valuation, or a share that changes from a date -->
      <Border Classes="glass" Padding="24,20" IsVisible="{Binding IsValuationOpen}">
        <StackPanel Spacing="12">
          <TextBlock Classes="title" Text="{Binding PanelTitle}" />
          <TextBlock Classes="secondary" Text="{l:T Assets_ValuationNote}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,16,*,16,2*">
            <StackPanel>
              <TextBlock Classes="fieldLabel" Text="{l:T Assets_ValueDate}" />
              <CalendarDatePicker SelectedDate="{Binding ValueDate}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="fieldLabel" Text="{l:T Assets_Value}" />
              <TextBox Text="{Binding ValueText}" PlaceholderText="0,00" AutomationProperties.Name="{l:T Assets_Value}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Classes="fieldLabel" Text="{l:T Assets_ValuationComment}" />
              <TextBox Text="{Binding ValueNote}" MaxLength="500" />
            </StackPanel>
          </Grid>
          <Border Classes="error" IsVisible="{Binding PanelError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding PanelError, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="{l:T Editor_Save}" Command="{Binding SaveValuationCommand}" />
            <Button Content="{l:T Accounts_Cancel}" Command="{Binding ClosePanelCommand}" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding HasValuations}">
            <TextBlock Classes="headline" Text="{l:T Assets_ValuationHistory}" />
            <ItemsControl ItemsSource="{Binding Valuations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ValuationRowViewModel">
                  <Grid ColumnDefinitions="140,Auto,*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding DateText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="headline" Text="{Binding ValueText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="caption" Margin="12,0" Text="{Binding Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Padding="10,4" FontSize="12" Content="{l:T Assets_Remove}" Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding CanArchive}">
            <Border Classes="separator" Margin="0,4" />
            <TextBlock Classes="caption" Text="{l:T Assets_ArchiveNote}" TextWrapping="Wrap" />
            <Button Content="{l:T Assets_Archive}" Command="{Binding ArchiveAssetCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="glass" Padding="24,20" IsVisible="{Binding IsShareOpen}">
        <StackPanel Spacing="12">
          <TextBlock Classes="title" Text="{Binding PanelTitle}" />
          <TextBlock Classes="secondary" Text="{l:T Assets_ShareNote}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="fieldLabel" Text="{l:T Assets_ShareFromDate}" />
              <CalendarDatePicker SelectedDate="{Binding ShareDate}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="fieldLabel" Text="{l:T Assets_YourShare}" />
              <TextBox Text="{Binding SharePercentText}" PlaceholderText="50" AutomationProperties.Name="{l:T Assets_YourShare}" />
            </StackPanel>
          </Grid>
          <Border Classes="error" IsVisible="{Binding PanelError, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding PanelError, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="{l:T Editor_Save}" Command="{Binding SaveShareCommand}" />
            <Button Content="{l:T Accounts_Cancel}" Command="{Binding ClosePanelCommand}" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding HasShareHistory}">
            <TextBlock Classes="headline" Text="{l:T Assets_ShareHistory}" />
            <ItemsControl ItemsSource="{Binding ShareHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AmountLineViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="headline" Text="{Binding AmountText}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- What is owned and what is owed, line by line -->
      <Border Classes="glass" Padding="24,20">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="{l:T Assets_Assets}" />
          <ItemsControl ItemsSource="{Binding AssetLines}" ItemTemplate="{StaticResource NetWorthLine}" />
        </StackPanel>
      </Border>

      <Border Classes="glass" Padding="24,20">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="{l:T Assets_Liabilities}" />
          <TextBlock Classes="caption" Text="{l:T Assets_LiabilitiesNote}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{l:T Assets_NoLiabilities}" IsVisible="{Binding !HasLiabilities}" />
          <ItemsControl ItemsSource="{Binding LiabilityLines}" ItemTemplate="{StaticResource NetWorthLine}" />
        </StackPanel>
      </Border>

      <!-- Net worth over the last twelve months -->
      <Border Classes="glass" Padding="24,20" IsVisible="{Binding HasHistory}">
        <StackPanel Spacing="10">
          <TextBlock Classes="title" Text="{l:T Assets_History}" />
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NetWorthBarViewModel">
                <Grid ColumnDefinitions="90,*,150" Margin="0,3">
                  <TextBlock Classes="caption" Text="{Binding Label}" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Classes="meter" Classes.over="{Binding IsNegative}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                               VerticalAlignment="Center" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Classes.debt="{Binding IsNegative}" Text="{Binding AmountText}" />
                    <TextBlock Classes="caption debt" Text="*" IsVisible="{Binding !IsComplete}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" Text="{Binding HistoryNote, StringFormat='*  {0}'}" TextWrapping="Wrap"
                     IsVisible="{Binding HistoryNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
