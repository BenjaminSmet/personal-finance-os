<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalFinanceOS.App.ViewModels"
             xmlns:l="using:PersonalFinanceOS.App.Localization"
             x:Class="PersonalFinanceOS.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <StackPanel Spacing="20">
    <TextBlock Classes="largeTitle" Text="{l:T Dashboard_Welcome}" />

    <!-- Hero: available money -->
    <Border Classes="glass strong" Padding="28,26" IsVisible="{Binding HasAccounts}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="overline" Text="{l:T Dashboard_Available}" />
          <TextBlock Classes="bigAmount" Text="{Binding LiquidTotalText}" />
          <TextBlock Classes="caption" Text="{l:T Dashboard_PhaseNote}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="10">
          <Border Classes="badge" HorizontalAlignment="Right">
            <TextBlock Classes="caption" Text="{Binding AccountsSummary}" />
          </Border>
          <Button Classes="primary" Content="{l:T Dashboard_GoToAccounts}" Command="{Binding GoToAccountsCommand}"
                  HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Safe-to-spend and items waiting to be confirmed (phase 4) -->
    <Border Classes="glass" Padding="24,20" IsVisible="{Binding HasSafeToSpend}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="overline" Text="{l:T Planning_SafeToSpend}" />
          <TextBlock Classes="amount" Text="{Binding SafeToSpendText}" Classes.debt="{Binding SafeIsNegative}" />
          <TextBlock Classes="caption" Text="{Binding SafeCaption}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <Button Content="{l:T Dashboard_GoToPlanning}" Command="{Binding GoToPlanningCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="{l:T Dashboard_GoToWishlist}" Command="{Binding GoToWishlistCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Items needing attention (spec §13); each says what it is in words, never by colour alone -->
    <Border Classes="glass" Padding="24,20" IsVisible="{Binding HasAttention}">
      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="{l:T Dashboard_Attention}" />
        <ItemsControl ItemsSource="{Binding Attention}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:AttentionItemViewModel">
              <Border Classes="warning" Margin="0,3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Text, StringFormat='⚠  {0}'}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Margin="10,0,0,0" Padding="12,5" FontSize="13" Content="{l:T Dashboard_View}"
                          Command="{Binding OpenCommand}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- This month: income and spending; transfers and card settlements never count -->
    <Border Classes="glass" Padding="24,20" IsVisible="{Binding HasAccounts}">
      <StackPanel Spacing="12">
        <TextBlock Classes="title" Text="{Binding MonthTitle}" />
        <Grid ColumnDefinitions="*,*,*">
          <StackPanel Spacing="2">
            <TextBlock Classes="overline" Text="{l:T Transactions_Income}" />
            <TextBlock Classes="amount" Text="{Binding MonthIncomeText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="overline" Text="{l:T Transactions_Expenses}" />
            <TextBlock Classes="amount" Text="{Binding MonthExpensesText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock Classes="overline" Text="{l:T Transactions_Net}" />
            <TextBlock Classes="amount" Text="{Binding MonthNetText}" />
          </StackPanel>
        </Grid>
        <Border Classes="separator" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="overline" Text="{l:T Dashboard_Budget}" />
            <StackPanel Spacing="6" IsVisible="{Binding BudgetText, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding BudgetText}" Classes.debt="{Binding BudgetIsOver}" />
              <ProgressBar Classes="meter" Classes.over="{Binding BudgetIsOver}" Maximum="100" Value="{Binding BudgetUsedPercent}" />
            </StackPanel>
            <TextBlock Classes="caption" Text="{l:T Dashboard_NoBudget}"
                       IsVisible="{Binding BudgetText, Converter={x:Static ObjectConverters.IsNull}}" />
          </StackPanel>
          <Button Grid.Column="1" Margin="16,0,0,0" Content="{l:T Dashboard_GoToBudgets}" Command="{Binding GoToBudgetsCommand}"
                  VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Coming up, and expected money in and out -->
    <Grid ColumnDefinitions="*,18,*" IsVisible="{Binding HasAccounts}">
      <Border Classes="glass" Padding="24,20">
        <StackPanel Spacing="10">
          <TextBlock Classes="title" Text="{l:T Dashboard_Upcoming}" />
          <TextBlock Classes="caption" Text="{l:T Dashboard_NothingUpcoming}" IsVisible="{Binding !HasUpcoming}" />
          <ItemsControl ItemsSource="{Binding Upcoming}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:UpcomingRowViewModel">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding DateText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding AmountText}" VerticalAlignment="Center" />
                  </Grid>
                  <Border Classes="separator" IsVisible="{Binding !IsLast}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="glass" Padding="24,20">
        <StackPanel Spacing="12">
          <TextBlock Classes="title" Text="{l:T Dashboard_CashFlow}" />
          <ItemsControl ItemsSource="{Binding CashFlows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CashFlowViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="overline" Text="{Binding Title}" />
                    <TextBlock Classes="caption" Text="{Binding InText, StringFormat='＋ {0}'}" />
                    <TextBlock Classes="caption" Text="{Binding OutText, StringFormat='－ {0}'}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="headline" Text="{Binding NetText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" Text="{l:T Planning_CashFlowNote}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Credit cards: what is owed and the next statement; available credit is not cash -->
    <Border Classes="glass" Padding="24,20" IsVisible="{Binding HasCards}">
      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="{l:T Dashboard_Cards}" />
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CardStatusViewModel">
              <StackPanel Spacing="2" Margin="0,4">
                <TextBlock Classes="headline" Text="{Binding Name}" />
                <TextBlock Classes="caption" Text="{Binding SummaryText}" TextWrapping="Wrap" IsVisible="{Binding IsSetUp}" />
                <TextBlock Classes="caption" Text="{Binding NextSettlementText}" TextWrapping="Wrap" IsVisible="{Binding IsSetUp}" />
                <TextBlock Classes="caption debt" Text="{l:T Card_NotSetUp}" TextWrapping="Wrap" IsVisible="{Binding !IsSetUp}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Net worth with its explanation, and savings and investments kept apart from spendable money (spec §13, §17) -->
    <Grid ColumnDefinitions="*,18,*" IsVisible="{Binding HasAccounts}">
      <Border Classes="glass" Padding="24,20">
        <StackPanel Spacing="2">
          <TextBlock Classes="overline" Text="{l:T Dashboard_NetWorth}" />
          <TextBlock Classes="amount" Text="{Binding NetWorthText}" Classes.debt="{Binding NetWorthIsNegative}" />
          <TextBlock Classes="caption" Text="{Binding NetWorthDetail}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{Binding NetWorthNote, StringFormat='ℹ  {0}'}" TextWrapping="Wrap"
                     IsVisible="{Binding NetWorthNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Button Margin="0,8,0,0" Padding="12,5" FontSize="13" Content="{l:T Dashboard_GoToAssets}" Command="{Binding GoToAssetsCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="glass" Padding="24,20">
        <StackPanel Spacing="2">
          <TextBlock Classes="overline" Text="{l:T Dashboard_Savings}" />
          <TextBlock Classes="amount" Text="{Binding SavingsText}" IsVisible="{Binding HasSavings}" />
          <TextBlock Classes="caption" Text="{l:T Dashboard_SavingsNote}" TextWrapping="Wrap" IsVisible="{Binding HasSavings}" />
          <TextBlock Classes="caption" Text="{l:T Dashboard_NoSavings}" TextWrapping="Wrap" IsVisible="{Binding !HasSavings}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Account tiles -->
    <ItemsControl ItemsSource="{Binding Tiles}" IsVisible="{Binding HasAccounts}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel ItemSpacing="16" LineSpacing="16" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:AccountRowViewModel">
          <Border Classes="glass" Width="250" Padding="18,16">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="34" Height="34" CornerRadius="17" Background="{Binding IconBackground}">
                  <Path Data="{Binding Icon}" Width="17" Height="17" Stretch="Uniform" Stroke="White"
                        StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Classes="headline" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="1">
                <TextBlock Classes="amount" Text="{Binding BalanceText}" Classes.debt="{Binding IsLiability}" />
                <TextBlock Classes="caption" Text="{Binding ShareText}" IsVisible="{Binding HasPartialShare}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- First start -->
    <Border Classes="glass" Padding="28,26" IsVisible="{Binding !HasAccounts}">
      <StackPanel Spacing="16">
        <TextBlock Text="{l:T Dashboard_Intro}" TextWrapping="Wrap" FontSize="16" />
        <Button Classes="primary" Content="{l:T Dashboard_GoToAccounts}" Command="{Binding GoToAccountsCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
