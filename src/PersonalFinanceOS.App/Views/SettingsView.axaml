<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalFinanceOS.App.ViewModels"
             xmlns:l="using:PersonalFinanceOS.App.Localization"
             x:Class="PersonalFinanceOS.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="largeTitle" Text="{l:T Settings_Title}" />

    <!-- Appearance -->
    <Border Classes="glass">
      <StackPanel Spacing="18">
        <TextBlock Classes="title" Text="{l:T Settings_Appearance}" />

        <StackPanel Spacing="8">
          <TextBlock Classes="fieldLabel" Text="{l:T Settings_Theme}" />
          <ListBox Classes="segmented" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                   AutomationProperties.Name="Theme">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ThemeOption">
                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="caption" Margin="4,0,0,0" Text="{l:T Settings_ThemeHint}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="separator" />

        <StackPanel Spacing="8">
          <TextBlock Classes="fieldLabel" Text="{l:T Settings_Language}" />
          <ListBox Classes="segmented" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                   AutomationProperties.Name="Language">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LanguageOption">
                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Data -->
    <Border Classes="glass">
      <StackPanel Spacing="14">
        <TextBlock Classes="title" Text="{l:T Settings_DataSection}" />
        <TextBlock Text="{l:T Settings_DataFolderNote}" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="{l:T Settings_DataFolder}" />
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Text="{Binding DataFolder}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0" />
            <Button Grid.Column="1" Margin="12,0,0,0" Content="{l:T Settings_OpenFolder}" Command="{Binding OpenDataFolderCommand}" />
          </Grid>
        </StackPanel>
        <Border Classes="warning">
          <TextBlock Text="{l:T Settings_Encryption}" TextWrapping="Wrap" />
        </Border>
        <TextBlock Classes="caption" Text="{l:T Settings_BackupComing}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- About -->
    <Border Classes="glass">
      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="{l:T Settings_About}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="secondary" Text="{l:T Settings_Version}" />
          <TextBlock Grid.Column="1" Text="{Binding AppVersion}" />
        </Grid>
        <Border Classes="separator" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="secondary" Text="{l:T Settings_Schema}" />
          <TextBlock Grid.Column="1" Text="{Binding SchemaVersion}" />
        </Grid>
        <Border Classes="separator" />
        <TextBlock Classes="caption" Text="{l:T Settings_Offline}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
