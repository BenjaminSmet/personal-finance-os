<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PersonalFinanceOS.App.ViewModels"
             xmlns:v="using:PersonalFinanceOS.App.Views"
             xmlns:l="using:PersonalFinanceOS.App.Localization"
             x:Class="PersonalFinanceOS.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="largeTitle" Text="{l:T Settings_Title}" />

    <!-- Appearance -->
    <Border Classes="glass">
      <StackPanel Spacing="18">
        <TextBlock Classes="title" Text="{l:T Settings_Appearance}" />

        <StackPanel Spacing="8">
          <TextBlock Classes="fieldLabel" Text="{l:T Settings_Theme}" />
          <ListBox Classes="segmented" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                   AutomationProperties.Name="Theme">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ThemeOption">
                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="caption" Margin="4,0,0,0" Text="{l:T Settings_ThemeHint}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="separator" />

        <StackPanel Spacing="8">
          <TextBlock Classes="fieldLabel" Text="{l:T Settings_Language}" />
          <ListBox Classes="segmented" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                   AutomationProperties.Name="Language">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:LanguageOption">
                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Data -->
    <Border Classes="glass">
      <StackPanel Spacing="14">
        <TextBlock Classes="title" Text="{l:T Settings_DataSection}" />
        <TextBlock Text="{l:T Settings_DataFolderNote}" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="{l:T Settings_DataFolder}" />
          <Grid ColumnDefinitions="*,Auto">
            <SelectableTextBlock Text="{Binding DataFolder}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0" />
            <Button Grid.Column="1" Margin="12,0,0,0" Content="{l:T Settings_OpenFolder}" Command="{Binding OpenDataFolderCommand}" />
          </Grid>
        </StackPanel>
        <Border Classes="warning">
          <TextBlock Text="{l:T Settings_Encryption}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Backup and restore -->
    <v:BackupView DataContext="{Binding Backup}" />

    <!-- Categories -->
    <Border Classes="glass">
      <StackPanel Spacing="14">
        <TextBlock Classes="title" Text="{l:T Settings_Categories}" />
        <TextBlock Classes="secondary" Text="{l:T Settings_CategoriesNote}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBox Text="{Binding NewCategoryName}" MaxLength="60" PlaceholderText="{l:T Settings_CategoryName}"
                   AutomationProperties.Name="{l:T Settings_CategoryName}" />
          <ComboBox Grid.Column="1" Margin="10,0,0,0" MinWidth="150" ItemsSource="{Binding CategoryKinds}" AutomationProperties.Name="{l:T Settings_CategoryKind}"
                    SelectedItem="{Binding NewCategoryKind}" IsEnabled="{Binding !IsRenaming}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:CategoryKindOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Margin="10,0,0,0" Classes="primary" Content="{l:T Settings_CategoryAdd}"
                  Command="{Binding SaveCategoryCommand}" IsVisible="{Binding !IsRenaming}" />
          <Button Grid.Column="2" Margin="10,0,0,0" Classes="primary" Content="{l:T Settings_CategoryRename}"
                  Command="{Binding SaveCategoryCommand}" IsVisible="{Binding IsRenaming}" />
          <Button Grid.Column="3" Margin="8,0,0,0" Content="{l:T Accounts_Cancel}" Command="{Binding CancelCategoryEditCommand}"
                  IsVisible="{Binding IsRenaming}" />
        </Grid>
        <Border Classes="error" IsVisible="{Binding CategoryError, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding CategoryError, StringFormat='✕  {0}'}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="success" IsVisible="{Binding CategoryMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding CategoryMessage, StringFormat='✓  {0}'}" TextWrapping="Wrap" />
        </Border>

        <!-- Merge: explained and confirmed first, because Undo cannot reverse it -->
        <Border Classes="glass row" Padding="18,16" IsVisible="{Binding IsMerging}">
          <StackPanel Spacing="10">
            <TextBlock Classes="headline" Text="{Binding MergeTitle}" />
            <ComboBox ItemsSource="{Binding MergeTargets}" SelectedItem="{Binding MergeTarget}" MinWidth="240"
                      AutomationProperties.Name="{Binding MergeTitle}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:CategoryOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Classes="warning">
              <TextBlock Text="{Binding MergeExplain}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="{l:T Settings_MergeConfirm}" Command="{Binding ConfirmMergeCommand}" />
              <Button Content="{l:T Accounts_Cancel}" Command="{Binding CancelMergeCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding CategoryRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CategoryRowViewModel">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="4,6">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <Border Classes="badge"><TextBlock Classes="caption" Text="{Binding KindName}" /></Border>
                  </StackPanel>
                  <Button Grid.Column="1" Content="▲" Padding="10,5" FontSize="13" Command="{Binding MoveUpCommand}"
                          IsEnabled="{Binding CanMoveUp}" ToolTip.Tip="{l:T Settings_MoveUp}" AutomationProperties.Name="{l:T Settings_MoveUp}" />
                  <Button Grid.Column="2" Margin="4,0,0,0" Content="▼" Padding="10,5" FontSize="13" Command="{Binding MoveDownCommand}"
                          IsEnabled="{Binding CanMoveDown}" ToolTip.Tip="{l:T Settings_MoveDown}" AutomationProperties.Name="{l:T Settings_MoveDown}" />
                  <Button Grid.Column="3" Margin="10,0,0,0" Content="{l:T Settings_CategoryRename}" Padding="12,5" FontSize="13"
                          Command="{Binding RenameCommand}" />
                  <Button Grid.Column="4" Margin="6,0,0,0" Content="{l:T Settings_CategoryMerge}" Padding="12,5" FontSize="13"
                          Command="{Binding MergeCommand}" />
                  <Button Grid.Column="5" Margin="6,0,0,0" Content="{l:T Accounts_Archive}" Padding="12,5" FontSize="13"
                          Command="{Binding ArchiveCommand}" />
                </Grid>
                <Border Classes="separator" IsVisible="{Binding !IsLast}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="6" IsVisible="{Binding HasArchivedCategories}">
          <TextBlock Classes="fieldLabel" Margin="4,8,0,0" Text="{l:T Settings_ArchivedCategories}" />
          <ItemsControl ItemsSource="{Binding ArchivedCategoryRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CategoryRowViewModel">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="4,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="secondary" Text="{Binding Name}" />
                      <Border Classes="badge"><TextBlock Classes="caption" Text="{Binding KindName}" /></Border>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{l:T Settings_Reactivate}" Padding="12,5" FontSize="13"
                            Command="{Binding ReactivateCommand}" />
                  </Grid>
                  <Border Classes="separator" IsVisible="{Binding !IsLast}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- About -->
    <Border Classes="glass">
      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="{l:T Settings_About}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="secondary" Text="{l:T Settings_Version}" />
          <TextBlock Grid.Column="1" Text="{Binding AppVersion}" />
        </Grid>
        <Border Classes="separator" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="secondary" Text="{l:T Settings_Schema}" />
          <TextBlock Grid.Column="1" Text="{Binding SchemaVersion}" />
        </Grid>
        <Border Classes="separator" />
        <TextBlock Classes="caption" Text="{l:T Settings_Offline}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
